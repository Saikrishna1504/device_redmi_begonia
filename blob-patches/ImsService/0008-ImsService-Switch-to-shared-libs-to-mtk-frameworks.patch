+        <uses-library android:name="mediatek-framework" android:required="true"/>
+        <uses-library android:name="mediatek-ims-base" android:required="true"/>
+        <uses-library android:name="mediatek-ims-common" android:required="true"/>
+        <uses-library android:name="mediatek-telephony-common" android:required="true"/>
+        <uses-library android:name="mediatek-telecom-common" android:required="true"/>
+        <uses-library android:name="mediatek-telephony-base" android:required="true"/>
         <service android:name="com.mediatek.ims.MtkDynamicImsService" android:permission="android.permission.BIND_IMS_SERVICE">
             <meta-data android:name="android.telephony.ims.MMTEL_FEATURE" android:value="true"/>
             <meta-data android:name="android.telephony.ims.EMERGENCY_MMTEL_FEATURE" android:value="true"/>
@@ -56,4 +63,4 @@
             </intent-filter>
         </service>
     </application>
-</manifest>
\ No newline at end of file
+</manifest>
